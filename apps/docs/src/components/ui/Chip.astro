---
// Mirrors the default Tabs trigger: 40pt pill, muted fill, foreground when active.
interface Props {
  active?: boolean
  href?: string
  /** Render a button so the docs can toggle it. */
  button?: boolean
  class?: string
  [key: string]: unknown
}
const { active = false, href, button = false, class: cls, ...rest } = Astro.props
const Tag = href ? 'a' : button ? 'button' : 'span'
---

<Tag href={href} type={button ? 'button' : undefined} class:list={['chip', { active }, cls]} {...rest}
  ><slot /></Tag
>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    height: var(--control-sm);
    padding: 0 var(--space-4);
    border-radius: var(--radius-control);
    background: var(--color-muted);
    color: var(--color-foreground);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      transform 90ms var(--ease),
      background-color 120ms var(--ease),
      color 120ms var(--ease);
  }
  a.chip:hover {
    background: var(--color-accent);
  }
  a.chip:active,
  button.chip:active {
    transform: scale(0.97);
  }
  button.chip {
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .active {
    background: var(--color-foreground);
    color: var(--color-background);
  }
</style>
