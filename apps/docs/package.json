{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/build-registry.mjs && node ../../scripts/copy-registry.mjs && node scripts/build-tokens.mjs && node scripts/build-changelog.mjs && astro dev",
    "build": "node ../../scripts/build-registry.mjs && node ../../scripts/copy-registry.mjs && node scripts/build-tokens.mjs && node scripts/build-changelog.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node scripts/build-changelog.mjs && node --test scripts/agent-docs.test.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "previews": "node scripts/capture-previews.mjs",
    "brand": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@eoria/core": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.2",
    "astro-expressive-code": "^0.44.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "wrangler": "^4.131.1"
  }
}
