---
// Header search. The button opens a dialog that finds pages and their sections by title,
// heading and description, and the keyboard alone can drive it. The index is /search.json,
// fetched the first time the dialog opens.
import { SECTIONS } from '../../lib/docs-nav.mjs'
---

<button type="button" class="trigger" data-search-open aria-haspopup="dialog">
  <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="9" cy="9" r="5.5"></circle>
    <path d="M13.2 13.2L17 17"></path>
  </svg>
  <span class="trigger-label">Search</span>
  <kbd data-search-kbd>⌘K</kbd>
</button>

<dialog class="search" data-search aria-label="Search the docs">
  <div class="field">
    <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="9" cy="9" r="5.5"></circle>
      <path d="M13.2 13.2L17 17"></path>
    </svg>
    <input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="search-results"
      aria-autocomplete="list"
      aria-label="Search components, blocks and guides"
      placeholder="Search components, blocks and guides"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      data-search-input
    />
    <button type="button" class="esc" data-search-close aria-label="Close search">Esc</button>
  </div>
  <ul class="results" id="search-results" role="listbox" aria-label="Results" data-search-results>
    {
      SECTIONS.map((s, i) => (
        <li role="presentation" data-search-default>
          <a href={s.home} role="option" id={`search-option-${i}`} aria-selected={i === 0}>
            <span class="text">
              <span class="title">{s.label}</span>
            </span>
            <span class="where">Section</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="empty" data-search-empty hidden>
    Nothing matches. Try a component name such as “sheet”, or a topic such as “dark mode”.
  </p>
  <p class="hints" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
  </p>
</dialog>

<style>
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 36px;
    padding: 0 var(--space-2) 0 var(--space-3);
    margin-right: var(--space-1);
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-muted);
    color: var(--color-muted-foreground);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      color 120ms var(--ease),
      transform 90ms var(--ease);
  }
  .trigger:hover {
    color: var(--color-foreground);
  }
  .trigger:active {
    transform: scale(0.97);
  }
  .trigger svg,
  .field svg {
    width: 16px;
    height: 16px;
    flex: none;
  }
  .trigger-label {
    min-width: 72px;
    text-align: left;
  }
  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 6px;
    background: var(--color-background);
    color: var(--color-muted-foreground);
    font-family: var(--font);
    font-size: 11px;
    font-weight: var(--weight-medium);
  }

  .search {
    width: min(620px, calc(100vw - 2 * var(--space-4)));
    max-height: min(560px, calc(100dvh - 16vh));
    margin: 12vh auto 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--color-elevated);
    color: var(--color-foreground);
    box-shadow:
      0 0 0 1px var(--color-border),
      0 24px 60px -12px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }
  .search[open] {
    display: flex;
    flex-direction: column;
    animation: search-in 140ms var(--ease);
  }
  .search::backdrop {
    background: rgb(0 0 0 / 0.4);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.985);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search[open] {
      animation: none;
    }
  }
  .field {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-muted-foreground);
  }
  .field input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-size: var(--text-md);
  }
  .field input::placeholder {
    color: var(--color-muted-foreground);
  }
  .esc {
    height: 24px;
    padding: 0 var(--space-2);
    border: 0;
    border-radius: 6px;
    background: var(--color-muted);
    color: var(--color-muted-foreground);
    font: inherit;
    font-size: 11px;
    font-weight: var(--weight-medium);
    cursor: pointer;
  }
  .results {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    scroll-padding: var(--space-2);
  }
  .results :global(a) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
  }
  .results :global(a[aria-selected='true']) {
    background: var(--color-muted);
  }
  .results :global(.text) {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 1px;
  }
  .results :global(.title) {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .results :global(.title .page) {
    color: var(--color-muted-foreground);
    font-weight: var(--weight-normal);
  }
  .results :global(.desc) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: var(--text-xs);
    color: var(--color-muted-foreground);
  }
  .results :global(.where) {
    flex: none;
    font-size: var(--text-xs);
    color: var(--color-muted-foreground);
  }
  .empty {
    margin: 0;
    padding: var(--space-8) var(--space-6);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
  .hints {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-2) var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-muted-foreground);
  }
  .hints span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .hints kbd {
    background: var(--color-muted);
  }

  @media (max-width: 1020px) {
    .trigger {
      width: 36px;
      padding: 0;
      justify-content: center;
      background: transparent;
    }
    .trigger:hover {
      background: var(--color-surface);
    }
    .trigger svg {
      width: 18px;
      height: 18px;
    }
    .trigger-label,
    .trigger kbd {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .search {
      margin-top: var(--space-4);
      max-height: calc(100dvh - 2 * var(--space-4));
    }
    .hints {
      display: none;
    }
  }
</style>

<script>
  type Page = {
    title: string
    description: string
    href: string
    section: string
    group: string
    headings: { slug: string; text: string }[]
  }
  type Hit = { href: string; title: string; page?: string; description: string; where: string; score: number }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search]')!
  const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!
  const list = dialog.querySelector<HTMLUListElement>('[data-search-results]')!
  const empty = dialog.querySelector<HTMLElement>('[data-search-empty]')!
  const defaults = list.innerHTML
  const LIMIT = 12

  const mac = /Mac|iPhone|iPad/.test(navigator.platform)
  document.querySelectorAll('[data-search-kbd]').forEach((k) => (k.textContent = mac ? '⌘K' : 'Ctrl K'))

  let pages: Promise<Page[]> | undefined
  const load = () => (pages ??= fetch('/search.json').then((r) => r.json()))

  /** How well one text answers one word. A match at the start of a word beats one inside it. */
  const rank = (text: string, word: string) => {
    const at = text.indexOf(word)
    if (at === -1) return 0
    if (at === 0) return text.length === word.length ? 5 : 4
    return /[\s\-/(]/.test(text[at - 1]) ? 3 : 1
  }

  function search(all: Page[], query: string): Hit[] {
    const words = query.toLowerCase().split(/\s+/).filter(Boolean)
    const hits: Hit[] = []
    for (const page of all) {
      const title = page.title.toLowerCase()
      const rest = `${page.description} ${page.group} ${page.section}`.toLowerCase()
      let score = 0
      let matched = true
      for (const word of words) {
        const inTitle = rank(title, word)
        const inRest = inTitle === 0 && rest.includes(word) ? 1 : 0
        if (inTitle === 0 && inRest === 0) matched = false
        score += inTitle * 20 + inRest * 4
      }
      if (matched) {
        hits.push({ href: page.href, title: page.title, description: page.description, where: page.section, score })
      }
      for (const heading of page.headings) {
        const text = heading.text.toLowerCase()
        // A heading answers the query when every word is in it or in its page title, and the
        // heading itself carries at least one of them.
        let own = 0
        let covered = true
        for (const word of words) {
          const inHeading = rank(text, word)
          own += inHeading
          if (inHeading === 0 && rank(title, word) === 0) covered = false
        }
        if (covered && own > 0) {
          hits.push({
            href: `${page.href}#${heading.slug}`,
            title: heading.text,
            page: page.title,
            description: page.description,
            where: page.section,
            score: own * 8,
          })
        }
      }
    }
    return hits.sort((a, b) => b.score - a.score).slice(0, LIMIT)
  }

  const options = () => Array.from(list.querySelectorAll<HTMLAnchorElement>('[role="option"]'))
  function select(index: number) {
    const all = options()
    if (all.length === 0) {
      input.removeAttribute('aria-activedescendant')
      return
    }
    const next = (index + all.length) % all.length
    all.forEach((a, i) => a.setAttribute('aria-selected', String(i === next)))
    input.setAttribute('aria-activedescendant', all[next].id)
    all[next].scrollIntoView({ block: 'nearest' })
  }
  const selected = () => options().findIndex((a) => a.getAttribute('aria-selected') === 'true')

  function show(hits: Hit[]) {
    list.replaceChildren(
      ...hits.map((hit, i) => {
        const li = document.createElement('li')
        li.setAttribute('role', 'presentation')
        const a = document.createElement('a')
        a.href = hit.href
        a.id = `search-option-${i}`
        a.setAttribute('role', 'option')
        const text = document.createElement('span')
        text.className = 'text'
        const title = document.createElement('span')
        title.className = 'title'
        if (hit.page) {
          const page = document.createElement('span')
          page.className = 'page'
          page.textContent = `${hit.page} › `
          title.append(page)
        }
        title.append(hit.title)
        const desc = document.createElement('span')
        desc.className = 'desc'
        desc.textContent = hit.description
        text.append(title, desc)
        const where = document.createElement('span')
        where.className = 'where'
        where.textContent = hit.where
        a.append(text, where)
        li.append(a)
        return li
      }),
    )
    list.hidden = hits.length === 0
    empty.hidden = hits.length > 0
    select(0)
  }

  async function update() {
    const query = input.value.trim()
    if (query === '') {
      list.innerHTML = defaults
      list.hidden = false
      empty.hidden = true
      select(0)
      return
    }
    const all = await load()
    // The reader may have typed more while the index loaded.
    if (input.value.trim() === query) show(search(all, query))
  }

  function open() {
    if (dialog.open) return
    void load()
    dialog.showModal()
    input.select()
    void update()
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open))
  dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close())
  // A click on the backdrop lands on the dialog element itself.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close()
  })
  input.addEventListener('input', () => void update())
  list.addEventListener('mousemove', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[role="option"]')
    if (a && a.getAttribute('aria-selected') !== 'true') select(options().indexOf(a))
  })
  // A hit on the page you are reading only changes the hash, so the dialog has to close itself.
  list.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[role="option"]')) dialog.close()
  })
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault()
      select(selected() + (e.key === 'ArrowDown' ? 1 : -1))
    } else if (e.key === 'Enter') {
      e.preventDefault()
      options()[selected()]?.click()
    }
  })
  window.addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement).tagName)
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault()
      open()
    }
  })
</script>
