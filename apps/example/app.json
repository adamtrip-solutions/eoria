{
  "expo": {
    "name": "eoria example",
    "slug": "eoria-example",
    "scheme": "eoria",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pt.adamtrip.eoria.example"
    },
    "android": {
      "package": "pt.adamtrip.eoria.example"
    },
    "plugins": ["expo-router", "expo-dev-client", "react-native-edge-to-edge"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
