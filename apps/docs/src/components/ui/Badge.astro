---
// Mirrors registry/ui/badge.tsx: pill, xs semibold label, accent tint by default.
interface Props {
  variant?: 'default' | 'solid' | 'outline' | 'destructive'
  class?: string
}
const { variant = 'default', class: cls } = Astro.props
---

<span class:list={['badge', `v-${variant}`, cls]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-accent-foreground);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: 1;
    white-space: nowrap;
  }
  .v-solid {
    background: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .v-outline {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-border);
    color: var(--color-foreground);
  }
  .v-destructive {
    background: var(--color-destructive);
    color: var(--color-destructive-foreground);
  }
</style>
