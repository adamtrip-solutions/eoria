---
import ThemeControls from './ThemeControls.astro'
const { pathname } = Astro.url
const nav = [
  { href: '/start/introduction/', label: 'Docs', active: pathname.startsWith('/start/') },
  { href: '/components/accordion/', label: 'Components', active: pathname.startsWith('/components/') },
  { href: '/demos/', label: 'Demos', active: pathname.startsWith('/demos') },
]
const repo = 'https://github.com/adamtrip-solutions/eoria'
---

<header class="header" data-header>
  <div class="container inner">
    <a href="/" class="brand" aria-label="eoria home">
      <span class="mark" aria-hidden="true"></span>
      eoria
    </a>
    <nav class="nav" aria-label="Primary">
      {
        nav.map((n) => (
          <a href={n.href} aria-current={n.active ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="spacer"></div>
    <div class="tools">
      <a class="icon-btn" href={repo} rel="noopener" aria-label="eoria on GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
      <ThemeControls />
      <button
        type="button"
        class="icon-btn menu-btn"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <svg class="open" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </svg>
        <svg class="close" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M5 5l10 10M15 5L5 15"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="mobile" id="mobile-menu" hidden>
    <nav class="container mobile-nav" aria-label="Primary, mobile">
      <a href="/">Home</a>
      {
        nav.map((n) => (
          <a href={n.href} aria-current={n.active ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
      <a href={repo} rel="noopener">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 200ms var(--ease),
      background-color 200ms var(--ease);
  }
  .header[data-scrolled],
  .header[data-menu-open] {
    border-bottom-color: var(--color-border);
  }
  .inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-right: var(--space-4);
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }
  .mark {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--color-primary);
    position: relative;
    transition: background-color 200ms var(--ease);
  }
  .mark::after {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 4px;
    background: var(--color-primary-foreground);
    opacity: 0.9;
  }
  .nav {
    display: flex;
    gap: var(--space-1);
  }
  .nav a {
    position: relative;
    height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-muted-foreground);
    transition:
      background-color 120ms var(--ease),
      color 120ms var(--ease);
  }
  .nav a:hover {
    background: var(--color-surface);
    color: var(--color-foreground);
  }
  .nav a[aria-current='page'] {
    color: var(--color-foreground);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 2px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-primary);
    transition: background-color 200ms var(--ease);
  }
  .spacer {
    flex: 1;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-muted-foreground);
    cursor: pointer;
    transition:
      background-color 120ms var(--ease),
      color 120ms var(--ease),
      transform 90ms var(--ease);
  }
  .icon-btn:hover {
    background: var(--color-surface);
    color: var(--color-foreground);
  }
  .icon-btn:active {
    transform: scale(0.94);
  }
  .icon-btn svg {
    width: 18px;
    height: 18px;
  }
  .menu-btn {
    display: none;
  }
  .menu-btn .close,
  .header[data-menu-open] .menu-btn .open {
    display: none;
  }
  .header[data-menu-open] .menu-btn .close {
    display: block;
  }
  .mobile {
    display: none;
  }
  .mobile-nav {
    display: grid;
    padding-top: var(--space-2);
    padding-bottom: var(--space-4);
  }
  .mobile-nav a {
    height: 48px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--color-muted-foreground);
  }
  .mobile-nav a:hover,
  .mobile-nav a[aria-current='page'] {
    background: var(--color-surface);
    color: var(--color-foreground);
  }
  @media (max-width: 640px) {
    .nav,
    .tools > a.icon-btn {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .mobile:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 4)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')
  const mobile = header.querySelector<HTMLElement>('#mobile-menu')
  if (toggle && mobile) {
    const setOpen = (open: boolean) => {
      mobile.hidden = !open
      header.toggleAttribute('data-menu-open', open)
      toggle.setAttribute('aria-expanded', String(open))
    }
    toggle.addEventListener('click', () => setOpen(mobile.hidden === true))
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobile.hidden !== true) setOpen(false)
    })
    window.matchMedia('(min-width: 641px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false)
    })
  }
</script>
