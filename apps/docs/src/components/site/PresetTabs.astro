---
// One tab per preset in @eoria/core. Each panel shows the palette, the line that uses the
// preset and the whole preset as an object to paste and edit. The code comes from the tokens
// at build time, so a preset added to core shows up here.
import { Code } from 'astro-expressive-code/components'
import { presets, type PresetName } from '@eoria/core/tokens'
import { presetHints, presetNames } from '../../lib/presets'
import { presetSource, presetUsage } from '../../lib/preset-code.mjs'

const swatches = ['background', 'surface', 'muted', 'primary', 'accent', 'destructive'] as const
const fontOf = (name: PresetName) => {
  const { font } = presets[name]
  const families = [font?.heading?.ios, font?.body?.ios].filter(Boolean)
  return families.length > 0 ? [...new Set(families)].join(' and ') : 'System font'
}
---

<div class="presets" data-preset-tabs>
  <div class="list" role="tablist" aria-label="Presets">
    {
      presetNames.map((name, i) => (
        <button
          type="button"
          role="tab"
          id={`preset-tab-${name}`}
          aria-controls={`preset-panel-${name}`}
          aria-selected={i === 0}
          tabindex={i === 0 ? 0 : -1}
          data-preset-tab={name}
        >
          <span class="dot" style={`background:${presets[name].light.primary}`} aria-hidden="true" />
          {name}
        </button>
      ))
    }
  </div>
  {
    presetNames.map((name, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`preset-panel-${name}`}
        aria-labelledby={`preset-tab-${name}`}
        hidden={i !== 0}
      >
        <div class="meta">
          <p>
            <strong>{presetHints[name]}.</strong> {fontOf(name)}.
          </p>
          <button type="button" class="try" data-preset-try={name}>
            Preview on this site
          </button>
        </div>
        <div class="palettes">
          {(['light', 'dark'] as const).map((mode) => (
            <div class="palette" style={`background:${presets[name][mode].background}`}>
              {swatches.map((key) => (
                <span
                  class="swatch"
                  style={`background:${presets[name][mode][key]}`}
                  title={`${mode} ${key} ${presets[name][mode][key]}`}
                />
              ))}
              <span class="mode" style={`color:${presets[name][mode].mutedForeground}`}>
                {mode}
              </span>
            </div>
          ))}
        </div>
        <p class="label">Use it as it is</p>
        <Code code={presetUsage(name)} lang="ts" title="src/unistyles.ts" />
        <p class="label">Or copy it and change it</p>
        <div class="source">
          <Code code={presetSource(name, presets[name])} lang="ts" title="src/unistyles.ts" />
        </div>
      </div>
    ))
  }
</div>

<style>
  .presets {
    margin: var(--space-5) 0 var(--space-8);
  }
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .list button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-sm);
    padding: 0 var(--space-4) 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-control);
    background: var(--color-muted);
    color: var(--color-foreground);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition:
      transform 90ms var(--ease),
      background-color 120ms var(--ease),
      color 120ms var(--ease);
  }
  .list button:active {
    transform: scale(0.97);
  }
  .list button[aria-selected='true'] {
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 1.5px color-mix(in srgb, currentColor 35%, transparent);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .meta p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
  .meta strong {
    color: var(--color-foreground);
    font-weight: var(--weight-semibold);
  }
  .try {
    height: 32px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-foreground);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition: background-color 120ms var(--ease);
  }
  .try:hover {
    background: var(--color-muted);
  }
  .palettes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .palette {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .swatch {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 1px rgb(128 128 128 / 0.28);
  }
  .mode {
    margin-left: auto;
    font-size: var(--text-xs);
  }
  .label {
    margin: var(--space-5) 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .source :global(pre) {
    max-height: 420px;
    overflow: auto;
  }
  @media (max-width: 520px) {
    .palettes {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-preset-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-preset-tab]'))
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)
        if (panel) panel.hidden = !on
      })
      if (focus) tab.focus()
    }
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab))
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0
        if (step === 0) return
        e.preventDefault()
        select(tabs[(i + step + tabs.length) % tabs.length], true)
      })
    })
    // Open on the preset the reader already picked for the site.
    const current = tabs.find((t) => t.dataset.presetTab === document.documentElement.dataset.preset)
    if (current) select(current)

    // The header menu owns the site preset. Pressing its option keeps both in step.
    root.querySelectorAll<HTMLButtonElement>('[data-preset-try]').forEach((button) => {
      button.addEventListener('click', () => {
        document
          .querySelector<HTMLButtonElement>(`[data-preset-option="${button.dataset.presetTry}"]`)
          ?.click()
      })
    })
  })
</script>
