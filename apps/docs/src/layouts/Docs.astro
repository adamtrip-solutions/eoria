---
import { getCollection } from 'astro:content'
import Base from './Base.astro'
import { existsSync } from 'node:fs'
import Badge from '../components/ui/Badge.astro'
import Preview from '../components/site/Preview.astro'
import { groupDocs } from '../lib/docs-nav.mjs'

interface Props {
  title: string
  description: string
  headings: { depth: number; slug: string; text: string }[]
  id: string
}
const { title, description, headings, id } = Astro.props

const groups = groupDocs(await getCollection('docs'))
const flat = groups.flatMap((g) => g.items)
const index = flat.findIndex((e) => e.id === id)
const prev = index > 0 ? flat[index - 1] : undefined
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined
const toc = headings.filter((h) => h.depth === 2)
const isComponent = id.startsWith('components/')
const previewName = id.replace(/^components\//, '')
const hasPreview = isComponent && existsSync(`public/previews/${previewName}-light.webp`)
---

<Base title={title} description={description} markdownPath={`/${id}.md`}>
  <div class="container shell">
    <aside class="sidebar">
      <details class="mobile-nav">
        <summary>Menu</summary>
        <div class="mobile-links">
          <a href="/">Home</a>
          <a href="https://github.com/adamtrip-solutions/eoria" rel="noopener">GitHub</a>
        </div>
      </details>
      <nav class="tree" aria-label="Docs">
        <input
          type="search"
          class="filter"
          placeholder="Filter components"
          aria-label="Filter components"
          data-sidebar-filter
        />
        {
          groups.map((g) => (
            <section aria-label={g.label} data-group={g.label === 'Start' ? 'start' : 'component'}>
              <p class="group">{g.label}</p>
              <ul>
                {g.items.map((e) => (
                  <li data-title={e.data.title.toLowerCase()}>
                    <a href={`/${e.id}/`} aria-current={e.id === id ? 'page' : undefined}>
                      {e.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>
    </aside>

    <main class="main">
      <article class="prose">
        {isComponent && <Badge class="kicker">Component</Badge>}
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        {hasPreview && <Preview name={previewName} title={title} />}
        <slot />
      </article>
      <nav class="pager" aria-label="Pagination">
        {
          prev ? (
            <a href={`/${prev.id}/`} class="pager-link">
              <span>Previous</span>
              <strong>{prev.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/${next.id}/`} class="pager-link right">
              <span>Next</span>
              <strong>{next.data.title}</strong>
            </a>
          )
        }
      </nav>
    </main>

    {
      toc.length > 0 && (
        <aside class="toc">
          <p class="group">On this page</p>
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    padding-top: var(--space-6);
    padding-bottom: var(--space-16);
  }
  .sidebar {
    position: sticky;
    top: var(--header-h);
    z-index: 10;
    background: var(--color-background);
  }
  .mobile-nav {
    display: none;
  }
  .filter {
    width: 100%;
    height: 40px;
    margin: 0 0 var(--space-4);
    padding: 0 var(--space-3);
    border: 1.5px solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-muted);
    color: var(--color-foreground);
    font: inherit;
    font-size: var(--text-sm);
    outline: none;
  }
  .filter::placeholder {
    color: var(--color-muted-foreground);
  }
  .filter:focus {
    border-color: var(--color-ring);
  }
  .tree section[hidden],
  .tree li[hidden] {
    display: none;
  }
  .tree .group {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted-foreground);
    margin: 0 0 var(--space-2) var(--space-3);
  }
  .tree section + section {
    margin-top: var(--space-6);
  }
  .tree ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tree a {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
    transition:
      background-color 120ms var(--ease),
      color 120ms var(--ease);
  }
  .tree a:hover {
    background: var(--color-surface);
    color: var(--color-foreground);
  }
  .tree a[aria-current='page'] {
    background: var(--color-muted);
    color: var(--color-foreground);
    font-weight: var(--weight-medium);
  }
  .main {
    min-width: 0;
  }
  .prose :global(.kicker) {
    margin-bottom: var(--space-3);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-12);
  }
  .pager-link {
    display: grid;
    gap: 2px;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: transform 90ms var(--ease);
  }
  .pager-link:active {
    transform: scale(0.985);
  }
  .pager-link span {
    font-size: var(--text-xs);
    color: var(--color-muted-foreground);
  }
  .pager-link strong {
    font-weight: var(--weight-semibold);
  }
  .right {
    text-align: right;
  }
  .toc {
    display: none;
  }
  .toc .group {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted-foreground);
    margin: 0 0 var(--space-2);
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc a {
    display: block;
    padding: 6px 0;
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
  .toc a:hover {
    color: var(--color-foreground);
  }

  @media (max-width: 899px) {
    .sidebar {
      margin: 0 calc(-1 * var(--space-5));
      padding: var(--space-2) var(--space-5);
      border-bottom: 1px solid var(--color-border);
    }
    .mobile-nav {
      display: block;
    }
    .mobile-nav summary {
      list-style: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      height: 40px;
      padding: 0 var(--space-4);
      border-radius: var(--radius-full);
      background: var(--color-muted);
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
    }
    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }
    .mobile-links {
      display: flex;
      gap: var(--space-4);
      padding: var(--space-3) var(--space-1) 0;
      font-size: var(--text-sm);
      color: var(--color-muted-foreground);
    }
    .tree {
      display: none;
      max-height: 60vh;
      overflow: auto;
      padding-top: var(--space-3);
    }
    .mobile-nav[open] + .tree {
      display: block;
    }
  }
  @media (min-width: 900px) {
    .shell {
      grid-template-columns: 220px minmax(0, 1fr);
      padding-top: var(--space-8);
    }
    .sidebar {
      align-self: start;
      max-height: calc(100vh - var(--header-h));
      overflow-y: auto;
      padding: var(--space-2) 0 var(--space-8);
      margin-top: calc(-1 * var(--space-2));
    }
    .prose {
      max-width: 720px;
    }
  }
  @media (min-width: 1200px) {
    .shell {
      grid-template-columns: 220px minmax(0, 1fr) 200px;
    }
    .toc {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + var(--space-8));
      align-self: start;
    }
  }
</style>

<script>
  // Every navigation is a full load on a static site, so carry the sidebar scroll over.
  const sidebar = document.querySelector<HTMLElement>('.sidebar')
  if (sidebar) {
    const saved = sessionStorage.getItem('eoria-sidebar-scroll')
    if (saved) sidebar.scrollTop = Number(saved)
    sidebar.addEventListener('scroll', () => {
      sessionStorage.setItem('eoria-sidebar-scroll', String(sidebar.scrollTop))
    })
  }

  const input = document.querySelector<HTMLInputElement>('[data-sidebar-filter]')
  const sections = document.querySelectorAll<HTMLElement>('.tree section[data-group="component"]')
  const start = document.querySelector<HTMLElement>('.tree section[data-group="start"]')
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase()
    if (start) start.hidden = q.length > 0
    sections.forEach((section) => {
      let visible = 0
      section.querySelectorAll<HTMLElement>('li[data-title]').forEach((li) => {
        const hit = q === '' || li.dataset.title!.includes(q)
        li.hidden = !hit
        if (hit) visible++
      })
      section.hidden = visible === 0
    })
  })
</script>
