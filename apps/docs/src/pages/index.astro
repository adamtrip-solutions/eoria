---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Button from '../components/ui/Button.astro'
import Badge from '../components/ui/Badge.astro'
import Iphone from '../components/ui/Iphone.astro'
import { CATEGORY_ORDER, byOrder } from '../lib/docs-nav.mjs'
import { screens } from '../lib/screens'
import { presetNames } from '../lib/presets'

const components = (await getCollection('docs')).filter((e) => e.id.startsWith('components/'))
const categories = CATEGORY_ORDER.map((label) => ({
  label,
  items: components.filter((e) => e.data.category === label).sort(byOrder),
}))
const byName = new Map(components.map((e) => [e.id.replace(/^components\//, ''), e]))

// Screens that read well at marquee size, in the order they scroll past.
const reel = ['button', 'input', 'tabs', 'dialog', 'select', 'toast', 'slider', 'card', 'accordion', 'switch']
  .map((name) => ({ name, entry: byName.get(name) }))
  .filter((r) => r.entry)

// Where the component sits in its capture, as an object-position. Most captures start a
// fifth of the way down; sheets and toasts sit at the bottom of the screen.
const focus: Record<string, string> = {
  dialog: '50% 100%',
  toast: '50% 100%',
  portal: '50% 32%',
  tooltip: '50% 18%',
}
const presets = presetNames

const steps = [
  {
    command: 'npx @eoria/cli init',
    body: 'Registers the themes with Unistyles, adds the Babel plugins and the path alias, and installs the peers.',
  },
  {
    command: 'npx @eoria/cli add button',
    body: 'Copies button.tsx and everything it depends on into components/ui, in dependency order.',
  },
  {
    command: 'components/ui/button.tsx',
    body: 'Now a file in your repo. Change a token, add a variant, or rewrite the recipe. Nothing to override.',
    file: true,
  },
  {
    command: 'npx @eoria/cli diff button',
    body: 'Shows what moved upstream since you copied it, and which derived files that may affect.',
  },
]

const principles = [
  {
    title: 'Native-first look',
    body: 'Tall buttons, filled fields, chips, bottom sheets and pill toasts. The patterns people already know from their phone.',
  },
  {
    title: 'Snappy by design',
    body: 'Timings of 90 to 150 ms and no springs. Reduce motion is honoured because Reanimated defaults to it.',
    demo: true,
  },
  {
    title: 'Themes that swap in place',
    body: 'Six presets, each a full look: palette, corner radii, type weights and typeface, in light and dark. Styles resolve in native code, so a preset change does not remount your screen.',
  },
  {
    title: 'One construct, typed all the way down',
    body: 'Every component is a slot recipe: slots, variants, defaults. Variants and theme keys are inferred, and a recipe you extend tracks its base.',
  },
]
---

<Base
  title="eoria"
  description="Native-first React Native components you copy into your app. Built on Unistyles and Reanimated."
>
  <main>
    <section class="container hero">
      <div class="copy">
        <p class="status"><Badge variant="outline">Alpha</Badge> Built for the New Architecture</p>
        <h1>Components that feel like the phone they run on.</h1>
        <p class="lead">
          eoria is a React Native component library you copy into your project. Built on Unistyles 3
          and Reanimated 4, styled after the apps people already use, and yours to change once the
          files land in your repo.
        </p>
        <div class="actions">
          <Button href="/start/installation/">Get started</Button>
          <Button href="/components/accordion/" variant="secondary">Browse components</Button>
        </div>
        <div class="install">
          <span class="prompt" aria-hidden="true">$</span>
          <code>npx @eoria/cli add button</code>
          <button type="button" class="copy-btn" data-copy="npx @eoria/cli add button">
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <div class="picker">
          <p>Pick a theme. Colours, corners, weights and typeface change together, here and in the app.</p>
          <div class="swatches" role="radiogroup" aria-label="Theme preset">
            {
              presets.map((p) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked="false"
                  aria-label={p}
                  title={p}
                  data-preset-option={p}
                  style={`--swatch-light: var(--swatch-${p}-light); --swatch-dark: var(--swatch-${p}-dark); --swatch-radius: var(--swatch-${p}-radius)`}
                />
              ))
            }
          </div>
        </div>
      </div>

      <a class="demo" href="/demos/" aria-label="See the demo screens">
        {
          [screens[1], screens[0], screens[2]].map((sc, i) => (
            <span class:list={['phone', i === 1 ? 'front' : 'back']}>
              <Iphone
                src={`/screens/${sc.name}-light.webp`}
                srcDark={`/screens/${sc.name}-dark.webp`}
                alt={`${sc.title} screen on an iPhone`}
              />
            </span>
          ))
        }
        <span class="demo-caption">Wallet, Home and Your order. Registry files only.</span>
      </a>
    </section>

    <section class="screens" aria-labelledby="screens-title">
      <div class="container section-head">
        <h2 id="screens-title">Real screens, not mockups.</h2>
        <p>
          Every component page shows the component captured from the example app on an iPhone, in
          light and dark. Open one.
        </p>
      </div>
      <div class="marquee">
        <div class="track">
          {
            [0, 1].map((copy) =>
              reel.map(({ name, entry }) => (
                <a
                  class="reel-item"
                  href={`/components/${name}/`}
                  aria-hidden={copy === 1 ? 'true' : undefined}
                  tabindex={copy === 1 ? -1 : undefined}
                >
                  <Iphone
                    src={`/previews/${name}-light.webp`}
                    srcDark={`/previews/${name}-dark.webp`}
                    alt={`${entry!.data.title} on an iPhone`}
                  />
                  <span class="reel-label">{entry!.data.title}</span>
                </a>
              )),
            )
          }
        </div>
      </div>
    </section>

    <section class="container own" aria-labelledby="own-title">
      <div class="own-copy">
        <h2 id="own-title">Copy it, then own it.</h2>
        <p>
          The registry hosts source, not a package. Four commands move a component into your repo
          and tell you when upstream changes.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <code class:list={{ file: s.file }}>{s.command}</code>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="container principles" aria-labelledby="principles-title">
      <h2 id="principles-title">What native feels like.</h2>
      <dl>
        {
          principles.map((p) => (
            <div class="principle">
              <dt>{p.title}</dt>
              <dd>
                {p.body}
                {p.demo && (
                  <span class="demo-row">
                    <Button size="sm" variant="secondary">
                      Press and hold
                    </Button>
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="container catalogue" aria-labelledby="catalogue-title">
      <div class="section-head">
        <h2 id="catalogue-title">{components.length} components, each one a file.</h2>
        <p>Grouped the way the sidebar groups them. Every tile is the component's own capture.</p>
      </div>
      {
        categories.map((cat) => (
          <div class="group">
            <h3>{cat.label}</h3>
            <div class="grid">
              {cat.items.map((c) => {
                const name = c.id.replace(/^components\//, '')
                return (
                  <a class="tile" href={`/${c.id}/`} style={`--focus: ${focus[name] ?? '50% 26%'}`}>
                    <span class="shot">
                      <img class="light" src={`/previews/${name}-light.webp`} alt="" loading="lazy" />
                      <img class="dark" src={`/previews/${name}-dark.webp`} alt="" loading="lazy" />
                    </span>
                    <span class="tile-text">
                      <span class="tile-title">{c.data.title}</span>
                      <span class="tile-body">{c.data.description}</span>
                    </span>
                  </a>
                )
              })}
            </div>
          </div>
        ))
      }
    </section>

    <footer class="container footer">
      <span>MIT licence</span>
      <a href="https://github.com/adamtrip-solutions/eoria" rel="noopener">adamtrip-solutions/eoria</a>
    </footer>
  </main>
</Base>

<style>
  /* Shared */
  h2 {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.1;
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .section-head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .section-head p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    color: var(--color-muted-foreground);
    max-width: 56ch;
  }

  /* Hero */
  .hero {
    display: grid;
    gap: var(--space-12);
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
    min-width: 0;
  }
  .status {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
  .copy h1 {
    margin: 0;
    font-size: clamp(44px, 6.6vw, 84px);
    line-height: 0.98;
    font-weight: var(--weight-bold);
    letter-spacing: -0.045em;
    max-width: 12ch;
    text-wrap: balance;
  }
  .lead {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    color: var(--color-muted-foreground);
    max-width: 50ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .install {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    height: 52px;
    padding: 0 var(--space-2) 0 var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-sm);
    max-width: 100%;
  }
  .prompt {
    font-family: var(--mono);
    color: var(--color-primary);
    transition: color 200ms var(--ease);
  }
  .install code {
    white-space: nowrap;
    overflow-x: auto;
  }
  .copy-btn {
    flex: none;
    height: 36px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    cursor: pointer;
    transition:
      transform 90ms var(--ease),
      background-color 120ms var(--ease);
  }
  .copy-btn:hover {
    background: var(--color-accent);
  }
  .copy-btn:active {
    transform: scale(0.96);
  }
  .picker {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }
  .picker p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
  .swatches {
    display: flex;
    gap: var(--space-3);
  }
  .swatches button {
    width: 36px;
    height: 36px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: calc(var(--swatch-radius) + 2px);
    background: var(--swatch-light);
    cursor: pointer;
    transition:
      transform 90ms var(--ease),
      border-color 120ms var(--ease);
  }
  :global(:root[data-mode='dark']) .swatches button {
    background: var(--swatch-dark);
  }
  .swatches button:hover {
    transform: scale(1.08);
  }
  .swatches button:active {
    transform: scale(0.92);
  }
  .swatches button[aria-checked='true'] {
    border-color: var(--color-foreground);
    box-shadow: inset 0 0 0 3px var(--color-background);
  }

  /*
    Three captures from the example app. The front phone is near device size; the two behind
    sit lower and smaller, so the cluster reads as one app rather than a gallery.
  */
  .demo {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.42fr 1fr;
    align-items: start;
    justify-self: center;
    width: min(100%, 560px);
    padding-bottom: var(--space-8);
  }
  .phone {
    display: block;
    min-width: 0;
    transition: transform 200ms var(--ease);
  }
  .phone :global(.iphone) {
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.18));
  }
  :global(:root[data-mode='dark']) .phone :global(.iphone) {
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.6));
  }
  .front {
    position: relative;
    z-index: 1;
    margin: 0 -8%;
  }
  .back {
    margin-top: 16%;
  }
  .demo:hover .front {
    transform: translateY(-6px);
  }
  .demo:hover .back {
    transform: translateY(-2px);
  }
  .demo:focus-visible {
    outline-offset: 8px;
    border-radius: var(--radius-2xl);
  }
  .demo-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }

  /* Load reveal: one sequence, copy first, then the phone, then the screen mounts. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .copy > * {
    animation: rise 640ms var(--ease) both;
  }
  .copy > :nth-child(2) {
    animation-delay: 60ms;
  }
  .copy > :nth-child(3) {
    animation-delay: 120ms;
  }
  .copy > :nth-child(4) {
    animation-delay: 180ms;
  }
  .copy > :nth-child(5) {
    animation-delay: 240ms;
  }
  .copy > :nth-child(6) {
    animation-delay: 300ms;
  }
  .phone,
  .demo-caption {
    animation: rise 720ms var(--ease) both;
  }
  .front {
    animation-delay: 160ms;
  }
  .back {
    animation-delay: 320ms;
  }
  .demo-caption {
    animation-delay: 520ms;
  }

  /* Screens */
  .screens {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track {
    display: flex;
    gap: var(--space-10);
    width: max-content;
    padding: var(--space-4) 0;
    animation: reel 110s linear infinite;
  }
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }
  @keyframes reel {
    to {
      transform: translateX(calc(-50% - var(--space-5)));
    }
  }
  /* Near device size, so the captures read as screens rather than thumbnails. */
  .reel-item {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    width: min(360px, 78vw);
    color: var(--color-muted-foreground);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    transition:
      transform 150ms var(--ease),
      color 150ms var(--ease);
  }
  .reel-item:hover {
    color: var(--color-foreground);
    transform: translateY(-6px);
  }
  .reel-item:focus-visible {
    outline-offset: 6px;
  }

  /* Own */
  .own {
    display: grid;
    gap: var(--space-10);
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-top: 1px solid var(--color-border);
  }
  .own-copy {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .own-copy p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
    color: var(--color-muted-foreground);
    max-width: 40ch;
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
  }
  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    display: grid;
    place-items: center;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }
  .steps code {
    display: inline-block;
    justify-self: start;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
    line-height: 1.4;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .steps code.file {
    background: transparent;
    padding-left: 0;
    color: var(--color-muted-foreground);
  }
  .steps p {
    margin: 0;
    color: var(--color-muted-foreground);
    line-height: var(--leading-md);
    max-width: 52ch;
  }

  /* Principles */
  .principles {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-top: 1px solid var(--color-border);
  }
  .principles dl {
    margin: var(--space-8) 0 0;
    display: grid;
    gap: 0 var(--space-10);
  }
  .principle {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .principle dt {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
  }
  .principle dd {
    margin: 0;
    color: var(--color-muted-foreground);
    line-height: var(--leading-md);
    max-width: 48ch;
  }
  .demo-row {
    display: block;
    margin-top: var(--space-4);
  }

  /* Catalogue */
  .catalogue {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-top: 1px solid var(--color-border);
  }
  .group + .group {
    margin-top: var(--space-10);
  }
  .group h3 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-muted-foreground);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(2, 1fr);
  }
  .tile {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-2);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    transition:
      transform 90ms var(--ease),
      background-color 200ms var(--ease);
  }
  .tile:hover {
    background: var(--color-muted);
  }
  .tile:active {
    transform: scale(0.985);
  }
  .shot {
    display: block;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-background);
    margin-bottom: var(--space-2);
    transition: background-color 200ms var(--ease);
  }
  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus);
  }
  .shot .dark {
    display: none;
  }
  :global(:root[data-mode='dark']) .shot .light {
    display: none;
  }
  :global(:root[data-mode='dark']) .shot .dark {
    display: block;
  }
  .tile-text {
    display: grid;
    gap: var(--space-1);
    padding: 0 var(--space-2) var(--space-2);
  }
  .tile-title {
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }
  .tile-body {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    color: var(--color-muted-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-6);
    padding-bottom: var(--space-10);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted-foreground);
  }
  .footer a:hover {
    color: var(--color-foreground);
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .principles dl {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: var(--space-10);
      padding-top: var(--space-16);
    }
    .own {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-16);
    }
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy > *,
    .phone,
    .demo-caption {
      animation: none;
    }
    .demo:hover .front,
    .demo:hover .back {
      transform: none;
    }
    .track {
      animation: none;
    }
    .marquee {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .reel-item:hover {
      transform: none;
    }
  }
</style>

<script>
  // Copy the install command.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.querySelector<HTMLElement>('[data-copy-label]')!
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!)
        label.textContent = 'Copied'
        setTimeout(() => (label.textContent = 'Copy'), 1500)
      } catch {
        label.textContent = 'Select it'
      }
    })
  })
</script>
